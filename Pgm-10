1. No Argument, No Return

#include <stdio.h>

void add()
{
    int a = 10, b = 20;
    printf("Sum = %d", a + b);
}

int main()
{
    add();
    return 0;
}

2. Argument, No Return

#include <stdio.h>

void add(int a, int b)
{
    printf("Sum = %d", a + b);
}

int main()
{
    add(10, 20);
    return 0;
}

3. No Argument, With Return


#include <stdio.h>

int add()
{
    int a = 10, b = 20;
    return a + b;
}

int main()
{
    printf("Sum = %d", add());
    return 0;
}


4. Argument, With Return

#include <stdio.h>

int add(int a, int b)
{
    return a + b;
}

int main()
{
    printf("Sum = %d", add(10, 20));
    return 0;
}
